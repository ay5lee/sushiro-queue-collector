# Postgres (docker-compose defaults)
POSTGRES_USER=sushiro
POSTGRES_PASSWORD=sushiro
POSTGRES_DB=sushiro_queue
DATABASE_URL=postgresql://sushiro:sushiro@db:5432/sushiro_queue

# SUSHI-PASS (unofficial)
SUSHI_PASS_BASE_URL=https://sushipass.sushiro.com.hk
STORELIST_LATITUDE=22
STORELIST_LONGITUDE=114
STORELIST_NUMRESULTS=100
STORELIST_REGION=HK

# Polling cadence (seconds). Prefer the slower end until error rates are known.
SWEEP_INTERVAL_SECONDS=60
STORE_SYNC_INTERVAL_SECONDS=21600
CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=12
MAX_REQUESTS_PER_MINUTE=90

# Backoff on 429 / 5xx / timeout
BACKOFF_INITIAL_SECONDS=2
BACKOFF_MAX_SECONDS=300
CIRCUIT_BREAK_FAILURE_RATIO=0.5
CIRCUIT_BREAK_MIN_SAMPLES=10
CIRCUIT_BREAK_COOLDOWN_SECONDS=300

# Store hours (Asia/Hong_Kong). API storelist has no per-store hours —
# use this configurable HK default window. Optional JSON overrides:
# STORE_HOURS_JSON={"7":{"open":"10:30","close":"22:00","close_fri_sat":"22:30"}}
DEFAULT_OPEN_TIME=10:30
DEFAULT_CLOSE_TIME=22:00
# Set to 1 to poll even outside hours (smoke tests only).
FORCE_POLL=0

# Logging
LOG_LEVEL=INFO
LOG_JSON=1
