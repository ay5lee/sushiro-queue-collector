# Paste these into the Portainer stack "Environment variables" UI.
# Do not check in a real .env, and do not set env_file: .env on the stack —
# GitOps clones have no .env next to the compose file.
POSTGRES_USER=sushiro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sushiro_queue
DATABASE_URL=postgresql://sushiro:change-me@db:5432/sushiro_queue

SWEEP_INTERVAL_SECONDS=60
CONCURRENCY=4
DEFAULT_OPEN_TIME=10:30
DEFAULT_CLOSE_TIME=22:00
FORCE_POLL=0
LOG_LEVEL=INFO
LOG_JSON=1
MAX_REQUESTS_PER_MINUTE=90
STORE_SYNC_INTERVAL_SECONDS=21600

# Optional per-store hour overrides (JSON object keyed by store_id):
# STORE_HOURS_JSON={"18":{"open":"10:30","close":"22:00","close_fri_sat":"22:30"}}
