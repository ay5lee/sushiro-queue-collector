# Copy into Portainer stack env (or rename to .env next to the stack).
POSTGRES_USER=sushiro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sushiro_queue
DATABASE_URL=postgresql://sushiro:change-me@db:5432/sushiro_queue

SWEEP_INTERVAL_SECONDS=60
CONCURRENCY=4
DEFAULT_OPEN_TIME=10:30
DEFAULT_CLOSE_TIME=22:00
FORCE_POLL=0
LOG_LEVEL=INFO
LOG_JSON=1

# Optional per-store hour overrides (JSON object keyed by store_id):
# STORE_HOURS_JSON={"18":{"open":"10:30","close":"22:00","close_fri_sat":"22:30"}}
